generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── User & Auth ─────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile            Profile?
  programs           Program[]
  dailyCheckIns      DailyCheckIn[]
  workoutSchedules   WorkoutSchedule[]
  workoutSessions    WorkoutSession[]
  exerciseLogs       ExerciseLog[]
  mealTemplates      MealTemplate[]
  habitLogs          HabitLog[]
  bodyMeasurements   BodyMeasurement[]
  goals              Goal[]
  creatineLogs       CreatineLog[]
  deviceTokens       DeviceToken[]
  reminders          Reminder[]
  idempotencyKeys    IdempotencyKey[]
}

// Client-supplied idempotency keys so retried sync ops don't double-apply.
model IdempotencyKey {
  id        String   @id @default(cuid())
  userId    String
  key       String
  opType    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  time      String
  timezone  String
  days      String
  type      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Profile ────────────────────────────────────────────

model Profile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  age                 Int?
  height              Float?
  programStartDate    DateTime?
  dailyCaloriesTarget Int?
  dailyProteinTarget  Int?
  dailyCarbsTarget    Int?
  dailyFatTarget      Int?
  dailyWaterTarget    Int?
  dailyStepsTarget    Int?
  dailyCaffeineTarget Int?
  sleepTarget         Float?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  creatineEnabled         Boolean          @default(false)
  creatineProtocol        CreatineProtocol @default(MAINTENANCE_ONLY)
  creatineStartDate       DateTime?
  creatineLoadingDays     Int              @default(7)
  creatineLoadingDose     Float            @default(20)
  creatineMaintenanceDose Float            @default(5)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Program & Workout Templates ────────────────────────

model Program {
  id              String           @id @default(cuid())
  userId          String
  name            String
  description     String?          @db.Text
  durationWeeks   Int              @default(8)
  isActive        Boolean          @default(false)
  progressionType ProgressionType  @default(LINEAR)
  roundTo         Float            @default(2.5)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts Workout[]
}

model Workout {
  id        String   @id @default(cuid())
  programId String
  name      String
  dayOfWeek Int
  notes     String?  @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program   Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]
  schedules WorkoutSchedule[]
  sessions  WorkoutSession[]

  @@unique([programId, dayOfWeek])
}

// ─── Exercise Library ───────────────────────────────────

model ExerciseLibrary {
  id           String       @id @default(cuid())
  name         String
  type         ExerciseType @default(WEIGHTED)
  muscleGroup  String?
  equipment    String?
  difficulty   String?
  instructions String?      @db.Text
  videoUrl     String?
  imageUrl     String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  workoutExercises WorkoutExercise[]

  @@unique([name])
}

model WorkoutExercise {
  id           String   @id @default(cuid())
  workoutId    String
  exerciseId   String
  sets         Int
  minReps      Int
  maxReps      Int
  startWeight  Float?
  targetWeight Float?
  restTime     Int?
  notes        String?  @db.Text
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workout      Workout         @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise     ExerciseLibrary @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  exerciseLogs ExerciseLog[]

  @@index([workoutId])
  @@index([exerciseId])
}

enum ExerciseType {
  WEIGHTED
  BODYWEIGHT
  TIMED
}

enum ProgressionType {
  LINEAR
  EXPONENTIAL
  SINUSOIDAL
}

// ─── Workout Calendar ───────────────────────────────────

model WorkoutSchedule {
  id        String         @id @default(cuid())
  userId    String
  date      DateTime
  workoutId String?
  status    ScheduleStatus @default(PLANNED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout Workout?        @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  session WorkoutSession?

  @@unique([userId, date])
}

enum ScheduleStatus {
  PLANNED
  COMPLETED
  SKIPPED
  REST
}

// ─── Workout Execution Log ──────────────────────────────

model WorkoutSession {
  id         String    @id @default(cuid())
  userId     String
  scheduleId String    @unique
  workoutId  String
  date       DateTime
  startedAt  DateTime?
  finishedAt DateTime?
  duration   Int?
  notes      String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule     WorkoutSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  workout      Workout          @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  exerciseLogs ExerciseLog[]
}

model ExerciseLog {
  id          String   @id @default(cuid())
  userId      String
  sessionId   String
  exerciseId  String
  setNumber   Int
  weight      Float?
  reps        Int?
  durationSec Int?
  rpe         Float?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session  WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise WorkoutExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([sessionId, exerciseId, setNumber])
}

// ─── Daily Check-in ─────────────────────────────────────

model DailyCheckIn {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime
  morningWeight Float?
  sleepHours    Float?
  calories      Int?
  protein       Int?
  carbs         Int?
  fat           Int?
  water         Int?
  steps         Int?
  caffeineMg    Int?
  energy        Int?
  mood          Int?
  soreness      Int?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodLog FoodLogEntry[]

  @@unique([userId, date])
}

// ─── Food Database & Meal Log (Phase 2) ─────────────────

model FoodItem {
  id                 String       @id @default(cuid())
  name               String
  servingSize        Float
  servingUnit        String
  caloriesPerServing Int
  proteinPerServing  Float
  carbsPerServing    Float
  fatPerServing      Float
  category           FoodCategory
  imageUrl           String?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  logEntries FoodLogEntry[]
  mealTemplateItems MealTemplateItem[]

  @@unique([name])
}

enum FoodCategory {
  PROTEIN
  CARBS
  FATS
  MEAL
  SNACK
  DRINK
  OTHER
}

model FoodLogEntry {
  id         String   @id @default(cuid())
  checkInId  String
  foodItemId String
  quantity   Float
  calories   Int
  protein    Float
  carbs      Float
  fat        Float
  createdAt  DateTime @default(now())

  checkIn  DailyCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  foodItem FoodItem     @relation(fields: [foodItemId], references: [id], onDelete: Restrict)
}

model MealTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealTemplateItem[]

  @@unique([userId, name])
}

model MealTemplateItem {
  id            String       @id @default(cuid())
  mealTemplateId String
  foodItemId    String
  quantity      Float
  createdAt     DateTime     @default(now())

  mealTemplate MealTemplate @relation(fields: [mealTemplateId], references: [id], onDelete: Cascade)
  foodItem     FoodItem     @relation(fields: [foodItemId], references: [id], onDelete: Restrict)

  @@index([mealTemplateId])
}

// ─── Habits ─────────────────────────────────────────────

model Habit {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs HabitLog[]

  @@unique([name])
}

model HabitLog {
  id        String   @id @default(cuid())
  userId    String
  habitId   String
  date      DateTime
  completed Boolean
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([userId, habitId, date])
}

// ─── Body Measurements ──────────────────────────────────

model BodyMeasurement {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime
  weight     Float?
  chest      Float?
  waist      Float?
  hips       Float?
  neck       Float?
  leftArm    Float?
  rightArm   Float?
  leftThigh  Float?
  rightThigh Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ─── Progress Photos ────────────────────────────────────

model ProgressPhoto {
  id        String    @id @default(cuid())
  date      DateTime
  type      PhotoType
  imageUrl  String
  createdAt DateTime  @default(now())
}

enum PhotoType {
  FRONT
  SIDE
  BACK
}

// ─── Goals ──────────────────────────────────────────────

model Goal {
  id           String   @id @default(cuid())
  userId       String
  name         String
  targetValue  Float
  currentValue Float    @default(0)
  unit         String
  type         GoalType
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum GoalType {
  WEIGHT
  EXERCISE
  NUTRITION
  SLEEP
  STEPS
  OTHER
}

// ─── Creatine Intake ────────────────────────────────────

model CreatineLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  doseGrams Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

enum CreatineProtocol {
  LOADING
  MAINTENANCE_ONLY
}
