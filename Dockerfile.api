# Somatix REST API — Hono. Same dependency tree as the web app (single package).
# Runs migrations + seed, then serves the API on :4000.
# Prisma version pinned via root package.json (^6.5.0); generate runs in this build.
FROM node:22-alpine AS base
WORKDIR /app

# deps: install everything (dev deps included so tsc + prisma CLI are available).
# prisma/ must be present — root postinstall runs `prisma generate`.
FROM base AS deps
COPY package.json package-lock.json* ./
COPY prisma ./prisma
RUN npm ci

# builder: compile the Hono API to api/dist and generate the Prisma client
FROM deps AS builder
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npx prisma generate
RUN npx tsc -p api/tsconfig.json

# runner: production image — runtime deps + compiled api + prisma schema/migrations
FROM base AS runner
ENV NODE_ENV=production
ENV PORT=4000
ENV HOSTNAME="0.0.0.0"
ENV HOME=/tmp

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nodejs
USER nodejs

# node_modules comes from builder so the prisma-generated client + query engine
# binary are included (they are produced by `prisma generate` during the build).
COPY --from=builder --chown=nodejs:nodejs /app/api/dist ./api/dist
COPY --from=builder --chown=nodejs:nodejs /app/prisma ./prisma
COPY --from=builder --chown=nodejs:nodejs /app/package.json ./package.json
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules

EXPOSE 4000
CMD ["node", "api/dist/index.js"]
